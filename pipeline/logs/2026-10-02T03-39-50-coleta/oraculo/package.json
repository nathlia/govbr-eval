{
  "name": "govbr-ds-validator-server",
  "version": "2.7.0",
  "description": "MCP server exposing gov.br Design System and e-MAG accessibility knowledge as a queryable validation oracle — TCC 2 artifact",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "govbr-ds-validator": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:data": "tsx scripts/build-data.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "scan:json": "node dist/cli/scan-page.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:wcag": "tsx scripts/build-wcag.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.10.0",
    "playwright": "^1.50.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@govbr-ds/core": "3.7.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
