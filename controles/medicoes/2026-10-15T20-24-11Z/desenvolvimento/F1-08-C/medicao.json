        "dom": {
          "html": "<html lang=\"pt-BR\"><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Atualizar dados de contato – Biblioteca Municipal</title>\n<link rel=\"stylesheet\" href=\"../recursos/core.min.css\">\n<link rel=\"stylesheet\" href=\"../recursos/fontawesome/css/all.min.css\">\n<link rel=\"stylesheet\" href=\"../recursos/biblioteca.css\">\n</head>\n<body>\n<nav class=\"br-skiplink\" aria-label=\"Atalhos de teclado\"><a class=\"br-item\" href=\"#conteudo\">Ir para o conteúdo</a></nav>\n<header class=\"br-header\" id=\"topo\">\n  <div class=\"container-lg\">\n    <div class=\"header-top\">\n      <div class=\"header-logo\"><img src=\"../recursos/logo.svg\" alt=\"\" width=\"40\" height=\"40\"><span class=\"br-divider vertical\"></span><div class=\"header-sign\">Prefeitura de Santa Aurora</div></div>\n    </div>\n    <div class=\"header-bottom\">\n      <div class=\"header-menu\">\n        <div class=\"header-info\">\n          <div class=\"header-title\">Biblioteca Municipal</div>\n          <div class=\"header-subtitle\">Reservas e renovação de empréstimos</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</header>\n<main id=\"conteudo\" class=\"container-lg\">\n<div class=\"row\">\n  <div class=\"col-md-8 col-lg-6\">\n    <h1>Atualizar dados de contato</h1>\n    <p>Mantenha seus dados em dia para receber os avisos de devolução e de reservas disponíveis.</p>\n    <form id=\"form-contato\" novalidate=\"\">\n<div class=\"br-input mb-3\">\n  <label for=\"cartao\">Número do cartão</label>\n  <input id=\"cartao\" name=\"cartao\" type=\"text\" inputmode=\"numeric\" autocomplete=\"off\">\n</div>\n<div class=\"br-input mb-3\">\n  <label for=\"email\">E-mail</label>\n  <input id=\"email\" name=\"email\" type=\"email\" autocomplete=\"email\">\n</div>\n<div class=\"br-input mb-3\">\n  <label for=\"telefone\">Telefone</label>\n  <input id=\"telefone\" name=\"telefone\" type=\"tel\" autocomplete=\"tel\">\n</div>\n      <button class=\"br-button primary\" type=\"submit\">Salvar dados</button>\n    </form>\n    <div id=\"resultado\" class=\"mt-4\" role=\"status\"></div>\n  </div>\n</div>\n</main>\n<footer class=\"br-footer\" id=\"rodape\">\n  <div class=\"container-lg\">\n    <nav class=\"links-rodape\" aria-label=\"Links do rodapé\">\n      <a href=\"#\">Acervo</a>\n      <a href=\"#\">Horários e endereço</a>\n      <a href=\"#\">Regulamento de empréstimos</a>\n    </nav>\n    <p class=\"texto-rodape\">Biblioteca Municipal de Santa Aurora · Rua das Acácias, 120 · Terça a sábado, das 9h às 18h</p>\n  </div>\n</footer>\n<script>\nconst formulario = document.getElementById('form-contato');\nconst cartao = document.getElementById('cartao');\nconst email = document.getElementById('email');\nconst telefone = document.getElementById('telefone');\nconst resultado = document.getElementById('resultado');\nfunction marcar(campo, texto) {\n  const caixa = campo.closest('.br-input');\n  caixa.classList.add('danger');\n  const mensagem = document.createElement('span');\n  mensagem.className = 'feedback danger';\n  mensagem.id = campo.id + '-erro';\n  mensagem.innerHTML = '<i class=\"fas fa-times-circle\" aria-hidden=\"true\"></i>' + texto;\n  caixa.appendChild(mensagem);\n}\nformulario.addEventListener('submit', (evento) => {\n  evento.preventDefault();\n  resultado.innerHTML = '';\n  [cartao, email, telefone].forEach((campo) => {\n    campo.closest('.br-input').classList.remove('danger');\n    campo.removeAttribute('aria-invalid');\n    campo.removeAttribute('aria-describedby');\n    const anterior = document.getElementById(campo.id + '-erro');\n    if (anterior) anterior.remove();\n  });\n  let erros = 0;\n  if (!/^\\d{8}$/.test(cartao.value.trim())) {\n    marcar(cartao, 'Informe os 8 dígitos impressos no cartão.');\n    cartao.setAttribute('aria-invalid', 'true');\n    cartao.setAttribute('aria-describedby', 'cartao-erro');\n    erros += 1;\n  }\n  if (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email.value.trim())) {\n    marcar(email, 'Use o formato nome@provedor.com.br.');\n    email.setAttribute('aria-invalid', 'true');\n    email.setAttribute('aria-describedby', 'email-erro');\n    erros += 1;\n  }\n  if (!/^\\d{10,11}$/.test(telefone.value.replace(/\\D/g, ''))) {\n    marcar(telefone, 'Valor inválido.');\n    telefone.setAttribute('aria-invalid', 'true');\n    telefone.setAttribute('aria-describedby', 'telefone-erro');\n    erros += 1;\n  }\n  if (erros === 0) {\n    resultado.textContent = 'Dados atualizados.';\n  }\n});\n</script>\n\n\n</body></html>",
