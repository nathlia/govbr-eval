        "html": "<html lang=\"pt-BR\"><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Resultados da busca – Biblioteca Municipal</title>\n<link rel=\"stylesheet\" href=\"../recursos/core.min.css\">\n<link rel=\"stylesheet\" href=\"../recursos/fontawesome/css/all.min.css\">\n<link rel=\"stylesheet\" href=\"../recursos/biblioteca.css\">\n</head>\n<body>\n<nav class=\"br-skiplink\" aria-label=\"Atalhos de teclado\"><a class=\"br-item\" href=\"#conteudo\">Ir para o conteúdo</a></nav>\n<header class=\"br-header\" id=\"topo\">\n  <div class=\"container-lg\">\n    <div class=\"header-top\">\n      <div class=\"header-logo\"><img src=\"../recursos/logo.svg\" alt=\"\" width=\"40\" height=\"40\"><span class=\"br-divider vertical\"></span><div class=\"header-sign\">Prefeitura de Santa Aurora</div></div>\n    </div>\n    <div class=\"header-bottom\">\n      <div class=\"header-menu\">\n        <div class=\"header-info\">\n          <div class=\"header-title\">Biblioteca Municipal</div>\n          <div class=\"header-subtitle\">Reservas e renovação de empréstimos</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</header>\n<main id=\"conteudo\" class=\"container-lg\">\n<h1>Resultados para \"Machado de Assis\"</h1>\n<p>12 títulos encontrados no acervo.</p>\n<button class=\"br-button secondary\" type=\"button\" id=\"filtros\" aria-expanded=\"false\"><i class=\"fas fa-filter mr-1\" aria-hidden=\"true\"></i><span class=\"texto\">Mostrar filtros</span></button>\n<div class=\"painel-filtros\" id=\"painel-filtros\" hidden=\"\">\n  <div class=\"br-checkbox\"><input id=\"f-disponivel\" name=\"f-disponivel\" type=\"checkbox\"><label for=\"f-disponivel\">Disponível agora</label></div>\n  <div class=\"br-checkbox\"><input id=\"f-digital\" name=\"f-digital\" type=\"checkbox\"><label for=\"f-digital\">Livro digital</label></div>\n</div>\n<div class=\"secao\">\n  <div class=\"br-list lista-livros\">\n    <div class=\"br-item\"><p class=\"titulo-livro mb-0\">Dom Casmurro</p><p class=\"detalhe-livro mb-0\">Romance, 1899</p></div>\n    <div class=\"br-item\"><p class=\"titulo-livro mb-0\">Memórias póstumas de Brás Cubas</p><p class=\"detalhe-livro mb-0\">Romance, 1881</p></div>\n    <div class=\"br-item\"><p class=\"titulo-livro mb-0\">Quincas Borba</p><p class=\"detalhe-livro mb-0\">Romance, 1891</p></div>\n  </div>\n</div>\n</main>\n<footer class=\"br-footer\" id=\"rodape\">\n  <div class=\"container-lg\">\n    <nav class=\"links-rodape\" aria-label=\"Links do rodapé\">\n      <a href=\"#\">Acervo</a>\n      <a href=\"#\">Horários e endereço</a>\n      <a href=\"#\">Regulamento de empréstimos</a>\n    </nav>\n    <p class=\"texto-rodape\">Biblioteca Municipal de Santa Aurora · Rua das Acácias, 120 · Terça a sábado, das 9h às 18h</p>\n  </div>\n</footer>\n<script>\nconst botao = document.getElementById('filtros');\nconst painel = document.getElementById('painel-filtros');\nbotao.addEventListener('click', () => {\n  painel.hidden = !painel.hidden;\n  botao.setAttribute('aria-expanded', String(!painel.hidden));\n});\n</script>\n\n\n</body></html>",
