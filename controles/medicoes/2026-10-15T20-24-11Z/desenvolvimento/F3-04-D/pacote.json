=\"br-scrim-util foco active\" id=\"scrim-horario\">\n  <div class=\"br-modal medium\" id=\"horario\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"horario-titulo\" data-tipo=\"informativa\">\n    <div class=\"br-modal-header\">\n      <div class=\"modal-title\" id=\"horario-titulo\">Horário de funcionamento</div>\n      <button class=\"br-button close circle\" type=\"button\" aria-label=\"Fechar\"><i class=\"fas fa-times\" aria-hidden=\"true\"></i></button>\n    </div>\n    <div class=\"br-modal-body\">\n      <p>Terça a sexta, das 9h às 18h.<br>Sábado, das 9h às 13h.<br>Fechada aos domingos, às segundas e nos feriados.</p>\n    </div>\n    <div class=\"br-modal-footer justify-content-end\">\n      <button class=\"br-button primary\" type=\"button\">Entendi</button>\n    </div>\n  </div>\n</div>\n<script>\n(function () {\n  const scrim = document.getElementById('scrim-horario');\n  const janela = document.getElementById('horario');\n  const abrir = document.getElementById('ver-horario');\n  const fechar = janela.querySelector('.br-modal-header .close');\n  let origem = null;\n  const fundo = [document.querySelector('.br-skiplink'), document.querySelector('header'), document.querySelector('main'), document.querySelector('footer')];\n  function focaveis() {\n    return Array.from(janela.querySelectorAll('button, [href], input, select, textarea')).filter((el) => !el.disabled);\n  }\n  function abrirJanela() {\n    origem = document.activeElement;\n    fundo.forEach((el) => { el.inert = true; });\n    scrim.classList.add('active');\n  }\n  function fecharJanela() {\n    scrim.classList.remove('active');\n    fundo.forEach((el) => { el.inert = false; });\n    origem.focus();\n  }\n  abrir.addEventListener('click', abrirJanela);\n  if (fechar) fechar.addEventListener('click', fecharJanela);\n  janela.querySelectorAll('.br-modal-footer .br-button').forEach((b) => b.addEventListener('click', fecharJanela));\n  janela.addEventListener('keydown', (e) => {\n    if (e.key === 'Escape') {\n      fecharJanela();\n    }\n    if (e.key === 'Tab') {\n      const lista = focaveis();\n      const primeiro = lista[0];\n      const ultimo = lista[lista.length - 1];\n      if (e.shiftKey && document.activeElement === primeiro) {\n        e.preventDefault();\n        ultimo.focus();\n      } else if (!e.shiftKey && document.activeElement === ultimo) {\n        e.preventDefault();\n        primeiro.focus();\n      }\n    }\n  });\n})();\n</script>\n\n\n</body></html>",
