{
  "name": "govbr-eval",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "axe": "tsx scripts/run-axe.ts",
    "eslint": "tsx scripts/run-eslint.ts",
    "snapshot:real": "tsx scripts/snapshot-real.ts",
    "baselines:fluxo": "tsx scripts/run-baselines-flow.ts",
    "score": "tsx scripts/score-results.ts",
    "score:verbose": "tsx scripts/score-results.ts --verbose",
    "score:json": "tsx scripts/score-results.ts --json",
    "score:fluxo": "tsx scripts/semantic-flow-cli.ts score",
    "score:fluxo:legacy": "tsx scripts/score-flow.ts",
    "ancoras": "tsx scripts/score-flow.ts --ancoras",
    "dashboard": "npm --prefix dashboard run dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p dashboard",
    "postinstall": "playwright install chromium",
    "kb:aliases": "tsx scripts/generate-kb-aliases.ts",
    "checker:aliases": "tsx scripts/generate-checker-aliases.ts",
    "case-matrix": "tsx scripts/case-matrix.ts",
    "lint:protocol": "tsx scripts/lint-protocol.ts",
    "lint:skills": "tsx scripts/lint-skill-contracts.ts",
    "test:pipeline": "pwsh -NoProfile -File pipeline/test-runner-support.ps1",
    "test:flow": "tsx scripts/test-flow-units.ts",
    "test:semantic": "tsx scripts/test-semantic-flow.ts",
    "flow:review": "tsx scripts/semantic-flow-cli.ts",
    "adjudicate": "tsx scripts/adjudicate-all.ts",
    "pacote:revisao": "tsx scripts/gerar-pacote-revisao.ts",
    "test:isolation": "tsx scripts/test-isolation.ts",
    "test:contract": "tsx scripts/test-flow-contract.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "4.11.1",
    "playwright": "1.61.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "22.19.7",
    "@typescript-eslint/parser": "8.47.0",
    "eslint": "9.39.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
