{
  "name": "govbr-eval",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "axe": "tsx scripts/run-axe.ts",
    "eslint": "tsx scripts/run-eslint.ts",
    "score": "tsx scripts/score-results.ts",
    "score:verbose": "tsx scripts/score-results.ts --verbose",
    "score:json": "tsx scripts/score-results.ts --json",
    "dashboard": "npm --prefix dashboard run dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p dashboard",
    "postinstall": "playwright install chromium",
    "kb:aliases": "tsx scripts/generate-kb-aliases.ts",
    "case-matrix": "tsx scripts/case-matrix.ts",
    "lint:protocol": "tsx scripts/lint-protocol.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "4.11.1",
    "playwright": "1.61.1"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "@typescript-eslint/parser": "8.47.0",
    "eslint": "9.39.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
