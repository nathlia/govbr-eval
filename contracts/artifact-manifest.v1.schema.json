{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govbr-eval.invalid/contracts/artifact-manifest.v1.schema.json",
  "title": "artifact-manifest.json — inventário do pacote de uma execução, v1",
  "description": "Caminho relativo, tamanho, tipo, papel e hash de cada arquivo do pacote, mais proveniência e versões de schema. Escrito pelo controlador ao fechar o pacote; validado antes de análise e de publicação. Caminho que escapa do pacote, absoluto, ou arquivo de referência/revisão invalidam o manifesto. Paths duplicados são recusados pelo validador (contracts/index.ts).",
  "type": "object",
  "required": ["contract", "fixture", "campaignId", "runId", "producedBy", "producedAt", "schemaVersions", "files"],
  "properties": {
    "contract": { "const": "artifact-manifest.v1" },
    "fixture": { "$ref": "common.v1.schema.json#/$defs/fixture" },
    "campaignId": { "$ref": "common.v1.schema.json#/$defs/id" },
    "runId": { "$ref": "common.v1.schema.json#/$defs/id" },
    "producedBy": { "$ref": "common.v1.schema.json#/$defs/text" },
    "producedAt": { "$ref": "common.v1.schema.json#/$defs/utcTimestamp" },
    "schemaVersions": {
      "type": "object",
      "required": ["run"],
      "properties": {
        "run": { "const": "run.v1" },
        "findings": { "const": "findings.v1" },
        "isolation": { "const": "isolation.v1" }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256", "mediaType", "role"],
        "properties": {
          "path": { "$ref": "common.v1.schema.json#/$defs/packagePath" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
          "mediaType": { "type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$" },
          "role": { "enum": ["run", "findings", "isolation", "tool-events", "evidence", "summary", "log", "refusal", "model-identity", "other"] }
        },
        "additionalProperties": false
      },
      "contains": { "properties": { "role": { "const": "run" } }, "required": ["role"] },
      "minContains": 1,
      "maxContains": 1
    }
  },
  "additionalProperties": false
}
