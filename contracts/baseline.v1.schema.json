{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govbr-eval.invalid/contracts/baseline.v1.schema.json",
  "title": "baseline.json — registro de uma linha de base arquivada, v1",
  "description": "Envelope de arquivo em volta do resultado bruto de scripts/run-baselines-flow.ts (FlowBaselines, linha-de-base-fluxo-2.x). Não redefine o formato do bruto: aponta para ele (hash + localização) e repete só o que a análise confere antes de abrir: status, escopo, versão, tempos e o vínculo ao manifesto de coleta, ao site, à referência e ao plano de estados/viewports. `identity` espelha ExecutableIdentity de scripts/collection-manifest.ts. Escrito pelo job de linhas de base (T4); lido pela análise (T6).",
  "type": "object",
  "required": [
    "contract", "fixture", "baselineId", "campaignId", "screen", "attempt", "rerunOf", "rerunReason", "producer",
    "scope", "status", "error", "raw", "timestamps", "links", "identity", "comparable", "diagnosticOnly", "eslint"
  ],
  "properties": {
    "contract": { "const": "baseline.v1" },
    "fixture": { "$ref": "common.v1.schema.json#/$defs/fixture" },
    "baselineId": { "$ref": "common.v1.schema.json#/$defs/id" },
    "campaignId": { "$ref": "common.v1.schema.json#/$defs/id" },
    "screen": { "$ref": "common.v1.schema.json#/$defs/screen" },
    "attempt": { "type": "integer", "minimum": 1 },
    "rerunOf": { "description": "Repetição técnica: novo artefato ligado ao anterior, nunca sobrescrita.", "oneOf": [{ "$ref": "common.v1.schema.json#/$defs/id" }, { "type": "null" }] },
    "rerunReason": { "oneOf": [{ "$ref": "common.v1.schema.json#/$defs/text" }, { "type": "null" }] },
    "producer": {
      "type": "object", "required": ["script", "baselineVersion"],
      "properties": {
        "script": { "const": "scripts/run-baselines-flow.ts" },
        "baselineVersion": { "type": "string", "pattern": "^linha-de-base-fluxo-[0-9]+\\.[0-9]+\\.[0-9]+$" }
      },
      "additionalProperties": false
    },
    "scope": { "description": "Só `bateria` é confrontável; o avulso dev-global nunca entra num registro de campanha.", "const": "bateria" },
    "status": { "description": "FlowBaselines.status.", "enum": ["complete", "failed"] },
    "error": { "oneOf": [{ "$ref": "common.v1.schema.json#/$defs/text" }, { "type": "null" }] },
    "raw": { "description": "O arquivo FlowBaselines bruto.", "$ref": "common.v1.schema.json#/$defs/recoverableObject" },
    "timestamps": {
      "type": "object", "required": ["startedAt", "finishedAt"],
      "properties": {
        "startedAt": { "$ref": "common.v1.schema.json#/$defs/utcTimestamp" },
        "finishedAt": { "oneOf": [{ "$ref": "common.v1.schema.json#/$defs/utcTimestamp" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "required": ["collectionManifest", "site", "reference", "statePlan"],
      "properties": {
        "collectionManifest": { "$ref": "common.v1.schema.json#/$defs/recoverableObject" },
        "site": { "$ref": "#/$defs/snapshotLink" },
        "reference": { "$ref": "#/$defs/snapshotLink" },
        "statePlan": { "$ref": "#/$defs/snapshotLink" }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["collection", "referenceSha256", "siteManifestSha256", "oracleDistSha256", "oracleDataSha256", "statePlanSha256"],
      "properties": {
        "collection": { "$ref": "common.v1.schema.json#/$defs/text" },
        "referenceSha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "siteManifestSha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "oracleDistSha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "oracleDataSha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "statePlanSha256": { "$ref": "common.v1.schema.json#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "comparable": { "description": "Os mesmos rótulos que semantic-flow-cli.ts grava em provenance.baseline.runs.", "const": ["linha-de-base/validator-nao-guiada", "linha-de-base/axe"] },
    "diagnosticOnly": { "const": ["linha-de-base/validator-guiada"] },
    "eslint": {
      "type": "object", "required": ["status", "absentReason"],
      "properties": {
        "status": { "enum": ["measured", "absent"] },
        "absentReason": { "oneOf": [{ "$ref": "common.v1.schema.json#/$defs/text" }, { "type": "null" }] }
      },
      "additionalProperties": false,
      "if": { "properties": { "status": { "const": "absent" } } },
      "then": { "properties": { "absentReason": { "type": "string" } } },
      "else": { "properties": { "absentReason": { "type": "null" } } }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": { "properties": { "error": { "type": "string" } } },
      "else": { "properties": { "error": { "type": "null" }, "timestamps": { "properties": { "finishedAt": { "type": "string" } } } } }
    },
    {
      "if": { "properties": { "rerunOf": { "type": "string" } } },
      "then": { "properties": { "rerunReason": { "type": "string" }, "attempt": { "minimum": 2 } } },
      "else": { "properties": { "rerunReason": { "type": "null" } } }
    }
  ],
  "$defs": {
    "snapshotLink": {
      "description": "Item de um snapshot-manifest, pelo id do conjunto e do item, com o hash conferido.",
      "type": "object", "required": ["snapshotSetId", "itemId", "sha256"],
      "properties": {
        "snapshotSetId": { "$ref": "common.v1.schema.json#/$defs/id" },
        "itemId": { "$ref": "common.v1.schema.json#/$defs/id" },
        "sha256": { "$ref": "common.v1.schema.json#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  }
}
