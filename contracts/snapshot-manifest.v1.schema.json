{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govbr-eval.invalid/contracts/snapshot-manifest.v1.schema.json",
  "title": "snapshot-manifest.json — cópias imutáveis para reprodução, v1",
  "description": "Aponta para os bytes necessários para reconstruir uma análise sem o workspace original: site servido (build, assets, configuração), referência, plano de estados/viewports, e código/distribuição + locks do instrumento. Cada item tem hash E localização recuperável; hash ou commit sem acesso aos bytes é inválido. Nenhum item é exposto ao agente. Escrito pela preparação/arquivamento (T1/T4); lido pela análise e pelo teste de restauração (T6/M3).",
  "type": "object",
  "required": ["contract", "fixture", "snapshotSetId", "createdAt", "items"],
  "properties": {
    "contract": { "const": "snapshot-manifest.v1" },
    "fixture": { "$ref": "common.v1.schema.json#/$defs/fixture" },
    "snapshotSetId": { "$ref": "common.v1.schema.json#/$defs/id" },
    "createdAt": { "$ref": "common.v1.schema.json#/$defs/utcTimestamp" },
    "items": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "kind", "description", "sha256", "bytes", "location", "immutable", "exposedToAgent"],
        "properties": {
          "id": { "$ref": "common.v1.schema.json#/$defs/id" },
          "kind": { "enum": ["site", "reference", "state-plan", "instrument", "oracle", "lockfile", "scorer"] },
          "description": { "$ref": "common.v1.schema.json#/$defs/text" },
          "sha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0 },
          "location": { "$ref": "common.v1.schema.json#/$defs/location" },
          "immutable": { "const": true },
          "exposedToAgent": { "const": false },
          "version": { "type": "string" }
        },
        "additionalProperties": false
      },
      "allOf": [
        { "contains": { "properties": { "kind": { "const": "site" } }, "required": ["kind"] } },
        { "contains": { "properties": { "kind": { "const": "reference" } }, "required": ["kind"] } },
        { "contains": { "properties": { "kind": { "const": "state-plan" } }, "required": ["kind"] } },
        { "contains": { "properties": { "kind": { "const": "instrument" } }, "required": ["kind"] } }
      ]
    }
  },
  "additionalProperties": false
}
