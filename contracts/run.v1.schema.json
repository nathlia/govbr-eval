{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govbr-eval.invalid/contracts/run.v1.schema.json",
  "title": "run.json — uma tentativa de execução do agente, v1",
  "description": "Escrito pelo CONTROLADOR da coleta, nunca pelo agente: identidade (campanha/slot/par/run/tentativa), tela, braço, modelo pedido e resolvido, versões, limites, estado do ciclo de vida, os cinco estados mínimos, falha, submissão e consumo.",
  "type": "object",
  "required": [
    "contract", "fixture", "campaignId", "slotId", "pairId", "runId", "attempt", "idempotencyKey",
    "screen", "arm", "repetition", "model", "provider", "effort", "client", "browser", "versions",
    "intervention", "limits", "isolationPolicyVersion", "timestamps", "lifecycle", "status", "failure",
    "submission", "usage", "artifactManifest", "isolation"
  ],
  "properties": {
    "contract": { "const": "run.v1" },
    "fixture": { "$ref": "common.v1.schema.json#/$defs/fixture" },
    "campaignId": { "$ref": "common.v1.schema.json#/$defs/id" },
    "slotId": { "$ref": "common.v1.schema.json#/$defs/id" },
    "pairId": { "$ref": "common.v1.schema.json#/$defs/id" },
    "runId": { "$ref": "common.v1.schema.json#/$defs/id" },
    "attempt": { "description": "Tentativa dentro do slot. Retry cria nova tentativa; nunca substitui a original.", "type": "integer", "minimum": 1 },
    "idempotencyKey": { "$ref": "common.v1.schema.json#/$defs/text" },
    "screen": { "$ref": "common.v1.schema.json#/$defs/screen" },
    "arm": { "$ref": "common.v1.schema.json#/$defs/arm" },
    "repetition": { "type": "integer", "minimum": 1 },
    "model": {
      "type": "object",
      "required": ["family", "requested", "resolved", "resolvedSource", "resolvedEvidence"],
      "properties": {
        "family": { "$ref": "common.v1.schema.json#/$defs/text" },
        "requested": { "$ref": "common.v1.schema.json#/$defs/text" },
        "resolved": {
          "description": "ID efetivo devolvido pelo fornecedor, ou \"unknown\" quando ele não expõe. Nunca copiado do pedido.",
          "$ref": "common.v1.schema.json#/$defs/text"
        },
        "resolvedSource": { "enum": ["provider-response", "client-log", "unknown"] },
        "resolvedEvidence": { "oneOf": [{ "$ref": "common.v1.schema.json#/$defs/packagePath" }, { "type": "null" }] }
      },
      "additionalProperties": false,
      "if": { "properties": { "resolved": { "const": "unknown" } } },
      "then": { "properties": { "resolvedSource": { "const": "unknown" }, "resolvedEvidence": { "type": "null" } } },
      "else": {
        "properties": {
          "resolvedSource": { "enum": ["provider-response", "client-log"] },
          "resolvedEvidence": { "$ref": "common.v1.schema.json#/$defs/packagePath" }
        }
      }
    },
    "provider": {
      "type": "object", "required": ["name", "authMethod"],
      "properties": {
        "name": { "$ref": "common.v1.schema.json#/$defs/text" },
        "authMethod": { "enum": ["api-key", "oauth-subscription", "unknown"] }
      },
      "additionalProperties": false
    },
    "effort": { "$ref": "common.v1.schema.json#/$defs/text" },
    "client": {
      "type": "object", "required": ["name", "version"],
      "properties": { "name": { "$ref": "common.v1.schema.json#/$defs/text" }, "version": { "$ref": "common.v1.schema.json#/$defs/text" } },
      "additionalProperties": false
    },
    "browser": {
      "type": "object", "required": ["name", "version", "headless"],
      "properties": {
        "name": { "$ref": "common.v1.schema.json#/$defs/text" },
        "version": { "$ref": "common.v1.schema.json#/$defs/text" },
        "headless": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "versions": {
      "type": "object",
      "required": ["protocolSha256", "promptSha256", "skillSha256", "harnessCommit", "siteManifestSha256", "playwrightMcp"],
      "properties": {
        "protocolSha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "promptSha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "skillSha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "harnessCommit": { "$ref": "common.v1.schema.json#/$defs/gitCommit" },
        "siteManifestSha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "playwrightMcp": { "$ref": "common.v1.schema.json#/$defs/text" }
      },
      "additionalProperties": false
    },
    "intervention": {
      "description": "A ÚNICA diferença prevista entre os braços: o pacote do oráculo. null no sem.",
      "type": "object", "required": ["oracle"],
      "properties": {
        "oracle": { "oneOf": [{ "$ref": "common.v1.schema.json#/$defs/oracleIdentity" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "limits": { "$ref": "common.v1.schema.json#/$defs/limits" },
    "isolationPolicyVersion": { "$ref": "common.v1.schema.json#/$defs/text" },
    "timestamps": {
      "type": "object", "required": ["plannedAt", "startedAt", "finishedAt"],
      "properties": {
        "plannedAt": { "$ref": "common.v1.schema.json#/$defs/utcTimestamp" },
        "startedAt": { "description": "Início da chamada ao modelo; null se o modelo nunca foi chamado.", "oneOf": [{ "$ref": "common.v1.schema.json#/$defs/utcTimestamp" }, { "type": "null" }] },
        "finishedAt": { "oneOf": [{ "$ref": "common.v1.schema.json#/$defs/utcTimestamp" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object", "required": ["state", "stage"],
      "properties": {
        "state": { "$ref": "common.v1.schema.json#/$defs/lifecycleState" },
        "stage": { "oneOf": [{ "$ref": "common.v1.schema.json#/$defs/stage" }, { "type": "null" }] }
      },
      "additionalProperties": false,
      "if": { "properties": { "state": { "enum": ["failed", "interrupted", "not-started"] } } },
      "then": { "properties": { "stage": { "$ref": "common.v1.schema.json#/$defs/stage" } } },
      "else": { "properties": { "stage": { "type": "null" } } }
    },
    "status": {
      "type": "object",
      "required": ["technical", "isolation", "protocol", "oracleUsage", "score"],
      "properties": {
        "technical": { "$ref": "common.v1.schema.json#/$defs/technicalStatus" },
        "isolation": { "$ref": "common.v1.schema.json#/$defs/isolationStatus" },
        "protocol": { "$ref": "common.v1.schema.json#/$defs/protocolStatus" },
        "oracleUsage": { "$ref": "common.v1.schema.json#/$defs/oracleUsage" },
        "score": { "$ref": "common.v1.schema.json#/$defs/scoreStatus" }
      },
      "additionalProperties": false
    },
    "failure": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "required": ["stage", "reason", "detail"],
          "properties": {
            "stage": { "$ref": "common.v1.schema.json#/$defs/stage" },
            "reason": { "$ref": "common.v1.schema.json#/$defs/failureReason" },
            "detail": { "$ref": "common.v1.schema.json#/$defs/text" }
          },
          "additionalProperties": false
        }
      ]
    },
    "submission": {
      "description": "accepted = o coletor aceitou um relatório (pode ter findings: []); refused = recusado, corpo arquivado; none = nenhuma submissão. Zero achados e ausência de submissão nunca se confundem.",
      "type": "object", "required": ["status", "findings", "refusal"],
      "properties": {
        "status": { "enum": ["accepted", "refused", "none"] },
        "findings": { "oneOf": [{ "$ref": "common.v1.schema.json#/$defs/packagePath" }, { "type": "null" }] },
        "refusal": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "required": ["reason", "archivedBody"],
              "properties": {
                "reason": { "$ref": "common.v1.schema.json#/$defs/text" },
                "archivedBody": { "$ref": "common.v1.schema.json#/$defs/packagePath" }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "status": { "const": "accepted" } } }, "then": { "properties": { "findings": { "type": "string" }, "refusal": { "type": "null" } } } },
        { "if": { "properties": { "status": { "const": "refused" } } }, "then": { "properties": { "findings": { "type": "null" }, "refusal": { "type": "object" } } } },
        { "if": { "properties": { "status": { "const": "none" } } }, "then": { "properties": { "findings": { "type": "null" }, "refusal": { "type": "null" } } } }
      ]
    },
    "usage": {
      "description": "Consumo medido pelo cliente/runner. Indisponível = { value: null, status: unavailable }. Valor estimado e cobrança efetiva ficam separados.",
      "type": "object",
      "required": ["wallClockSeconds", "inputTokens", "outputTokens", "cacheReadTokens", "cacheCreationTokens", "turns", "toolCalls", "oracleCalls", "estimatedCostUsd", "billedCostUsd"],
      "properties": {
        "wallClockSeconds": { "$ref": "common.v1.schema.json#/$defs/metric" },
        "inputTokens": { "$ref": "common.v1.schema.json#/$defs/metric" },
        "outputTokens": { "$ref": "common.v1.schema.json#/$defs/metric" },
        "cacheReadTokens": { "$ref": "common.v1.schema.json#/$defs/metric" },
        "cacheCreationTokens": { "$ref": "common.v1.schema.json#/$defs/metric" },
        "turns": { "$ref": "common.v1.schema.json#/$defs/metric" },
        "toolCalls": { "$ref": "common.v1.schema.json#/$defs/metric" },
        "oracleCalls": { "$ref": "common.v1.schema.json#/$defs/metric" },
        "estimatedCostUsd": { "$ref": "common.v1.schema.json#/$defs/metric" },
        "billedCostUsd": { "$ref": "common.v1.schema.json#/$defs/metric" }
      },
      "additionalProperties": false
    },
    "artifactManifest": { "$ref": "common.v1.schema.json#/$defs/packagePath" },
    "isolation": { "oneOf": [{ "$ref": "common.v1.schema.json#/$defs/packagePath" }, { "type": "null" }] }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "arm": { "const": "sem" } } },
      "then": {
        "properties": {
          "intervention": { "properties": { "oracle": { "type": "null" } } },
          "status": { "properties": { "oracleUsage": { "enum": ["absent-verified", "unverified", "not-applicable"] } } }
        }
      }
    },
    {
      "if": { "properties": { "arm": { "const": "com" } } },
      "then": {
        "properties": {
          "intervention": { "properties": { "oracle": { "type": "object" } } },
          "status": { "properties": { "oracleUsage": { "not": { "const": "absent-verified" } } } }
        }
      }
    },
    {
      "if": { "properties": { "status": { "properties": { "technical": { "const": "not-run" } } } } },
      "then": {
        "properties": {
          "lifecycle": { "properties": { "state": { "enum": ["not-started", "failed"] }, "stage": { "enum": ["preparing", "preflight"] } } },
          "timestamps": { "properties": { "startedAt": { "type": "null" } } },
          "failure": { "type": "object" },
          "submission": { "properties": { "status": { "const": "none" } } },
          "status": {
            "properties": {
              "protocol": { "const": "not-applicable" },
              "oracleUsage": { "const": "not-applicable" },
              "score": { "const": "not-applicable" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "properties": { "technical": { "enum": ["failed", "interrupted"] } } } } },
      "then": { "properties": { "failure": { "type": "object" } } }
    },
    {
      "if": { "properties": { "status": { "properties": { "technical": { "const": "passed" } } } } },
      "then": {
        "properties": {
          "failure": { "type": "null" },
          "lifecycle": { "properties": { "state": { "enum": ["collected", "archived"] } } },
          "submission": { "properties": { "status": { "const": "accepted" } } }
        }
      }
    },
    {
      "if": { "properties": { "submission": { "properties": { "status": { "const": "none" } } } } },
      "then": { "properties": { "status": { "properties": { "score": { "const": "not-applicable" } } } } }
    }
  ]
}
